# ========================================================
# Academic Resource Sharing Hub (ARH) — Environment Configuration
# ========================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# JWT Authentication & Cryptographic Signing
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# MySQL Database Connection Settings (Dual-Mode: Auto-detects MySQL or Resilient In-Memory Fallback)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=arh_db

# Institutional SMTP Email Service Configuration
# Required for Faculty Registration Email Verification
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@arh-academic.edu
